  "item": [
    {
      "name": "1. Sistema",
      "item": [
        {
          "name": "Healthcheck",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/healthcheck",
              "host": ["{{baseUrl}}"],
              "path": ["healthcheck"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Pokemones",
      "item": [
        {
          "name": "Listar Pokemones (Paginado Básico)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/pokemones?page=1&limit=5",
              "host": ["{{baseUrl}}"],
              "path": ["api", "pokemones"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "5" }
              ]
            }
          }
        },
        {
          "name": "Filtros Avanzados (Tipos y Stats Planas)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/pokemones?tipo=fuego&vidaMin=35&ataqueEspecialMax=100&page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "pokemones"],
              "query": [
                { "key": "tipo", "value": "fuego" },
                { "key": "vidaMin", "value": "35" },
                { "key": "ataqueEspecialMax", "value": "100" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Obtener Pokémon por ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/pokemones/4",
              "host": ["{{baseUrl}}"],
              "path": ["api", "pokemones", "4"]
            }
          }
        }
      ]
    },
